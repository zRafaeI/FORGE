# FORGE — variáveis de ambiente
# Sem estas variáveis, o FORGE funciona só neste navegador (sem conta).
# Com elas, exige login e sincroniza os dados com o Supabase.
# Use apenas a chave PÚBLICA (publishable/anon). Nunca coloque aqui a chave secret/service_role.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
